---
import { AnalyticsPageContent } from './AnalyticsPageContent'
import type { StratifiedRow } from '@/lib/parquet'

interface Props {
  title: string
  text?: string
  allStratifiedData?: Record<string, StratifiedRow[]>
}

const { title, allStratifiedData = {} } = Astro.props
---

<div class="mx-auto max-w-[120em] px-2 sm:px-6 lg:px-10 mb-16">
  <div class="flex flex-col gap-2">
    <h1 class="text-3xl font-bold my-6">{title}</h1>
    <AnalyticsPageContent
      allStratifiedData={allStratifiedData}
      client:only="react"
    />
  </div>
</div>
