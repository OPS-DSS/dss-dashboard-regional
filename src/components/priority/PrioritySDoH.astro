---
import { app, indicators } from '@/config/general'
import type { StratifiedRow } from '@/lib/parquet'

interface Props {
  title: string
  text: string
  allStratifiedData?: Record<string, StratifiedRow[]>
  contextData?: Record<string, StratifiedRow[]>
}

const { title, text, allStratifiedData = {}, contextData = {} } = Astro.props

const countries = [
  ...new Set(
    Object.values(allStratifiedData)
      .flat()
      .map((row) => String(row.territorio ?? '').trim())
      .filter((territory) => Boolean(territory) && territory !== app.local),
  ),
].sort((a, b) => a.localeCompare(b, 'es'))

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/'

const dimensionLabels: Record<string, string> = {
  dss: 'Indicadores',
  policy: 'Políticas',
}

const dssAreas = [
  { slug: 'economia', label: 'Trabajo, ingresos, seguridad económica y desigualdad' },
  { slug: 'educacion', label: 'Educación' },
  { slug: 'ambiente', label: 'Ambiente físico' },
  { slug: 'comunidad', label: 'Contexto social y comunitario' },
  { slug: 'salud', label: 'Conductas relacionadas con la salud' },
  { slug: 'sistema', label: 'Sistema de atención de salud' },
]
---

<div class="mx-auto max-w-7xl px-2 sm:px-6 lg:px-10">
  <div class="flex flex-col gap-2">
    <h1 class="text-3xl font-bold my-6">{title}</h1>
    <p class="text-gray-700">{text}</p>

    <div id="country-selector" class="mt-4 rounded-lg border border-gray-200 p-5">
      <label for="country-select" class="block text-sm font-medium text-gray-700 mb-2">
        Seleccione un país de la Región de las Américas
      </label>
      <div class="flex flex-col sm:flex-row gap-3 sm:items-center">
        <select
          id="country-select"
          class="min-w-72 rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-800"
        >
          <option value="">Seleccione un país</option>
          {countries.map((country) => <option value={country}>{country}</option>)}
        </select>
        <button
          id="country-enter-btn"
          type="button"
          class="rounded-lg bg-gray-800 px-4 py-2 text-sm font-medium text-white disabled:opacity-40"
          disabled
        >
          Ver indicadores
        </button>
      </div>
    </div>

    <div id="country-content" class="hidden">
      <div class="mt-4 flex items-center justify-between gap-3 flex-wrap">
        <p class="text-sm text-gray-600">
          País seleccionado: <strong id="selected-country-label"></strong>
        </p>
        <button
          id="change-country-btn"
          type="button"
          class="text-sm font-medium text-blue-700 hover:underline"
        >
          Cambiar país
        </button>
      </div>

    <section id="country-context" class="mt-5"><h2 class="text-lg font-semibold text-gray-900 mb-3">Contexto del país</h2><div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-3">
<article class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm"><p class="text-sm text-gray-600">Población total</p><p data-context-value="poblacion" class="mt-1 text-2xl font-semibold text-gray-900">—</p><p data-context-meta="poblacion" class="mt-1 text-xs text-gray-500"></p></article>
<article class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm"><p class="text-sm text-gray-600">PIB per cápita</p><p data-context-value="pib-per-capita" class="mt-1 text-2xl font-semibold text-gray-900">—</p><p data-context-meta="pib-per-capita" class="mt-1 text-xs text-gray-500"></p></article>
<article class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm"><p class="text-sm text-gray-600">Esperanza de vida al nacer</p><p data-context-value="esperanza-vida" class="mt-1 text-2xl font-semibold text-gray-900">—</p><p data-context-meta="esperanza-vida" class="mt-1 text-xs text-gray-500"></p></article>
<article class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm"><p class="text-sm text-gray-600">Tasa de mortalidad bruta</p><p data-context-value="mortalidad-bruta" class="mt-1 text-2xl font-semibold text-gray-900">—</p><p data-context-meta="mortalidad-bruta" class="mt-1 text-xs text-gray-500"></p></article>
</div></section>
    <div class="flex flex-col gap-3 mt-4">
      <div class="flex gap-3 items-center">
        <div
          class="flex rounded-lg border border-gray-300 overflow-hidden text-sm"
        >
          {
            Object.entries(dimensionLabels).map(([dim, label], i) => (
              <button
                data-dim-btn={dim}
                type="button"
                aria-pressed={i === 0 ? 'true' : 'false'}
                class={
                  i === 0
                    ? 'px-4 py-2 font-medium bg-gray-800 text-white transition-colors'
                    : 'px-4 py-2 font-medium bg-white text-gray-700 hover:bg-gray-50 transition-colors'
                }
              >
                {label}
              </button>
            ))
          }
        </div>
      </div>

      <div class="flex gap-2 flex-wrap">
        {dssAreas.map((area) => (
          <button
            data-subdim-tag={area.slug}
            data-subdim-dim="all"
            type="button"
            aria-pressed="true"
            class="px-3 py-1 rounded-full text-xs font-medium border transition-colors bg-blue-700 text-white border-blue-700"
          >
            {area.label}
          </button>
        ))}
      </div>
    </div>

    <ul id="indicators-list" class="mt-4 flex flex-col gap-4">
      {
        indicators.map((ind) => (
          <li
            data-dimension={ind.dimension}
            data-subdimensions={ind.area ?? ind.subdimensions.join(',')}
            data-indicator-slug={ind.slug}
          >
            <a
              href={`${base}${ind.slug}`}
              data-indicator-href={`${base}${ind.slug}`}
              class="block rounded-lg border border-gray-200 p-4 hover:border-blue-400 hover:shadow-sm transition-all"
            >
              <h3 class="text-lg font-semibold text-gray-900">{ind.title}</h3>
              <p class="mt-1 text-sm text-gray-600">{ind.description}</p>
              <div class="mt-3 flex flex-wrap gap-2">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-700 border border-gray-200">
                  {dimensionLabels[ind.dimension] ?? ind.dimension}
                </span>
                {ind.subdimensions.map((sub) => (
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-50 text-blue-700 border border-blue-200 capitalize">
                    {sub}
                  </span>
                ))}
              </div>
            </a>
          </li>
        ))
      }
    </ul>

    <p id="empty-message" class="text-gray-500 italic mt-4 hidden">
      No hay indicadores disponibles para los filtros seleccionados.
    </p>
    </div>
  </div>
</div>
<script id="country-context-data" type="application/json" set:html={JSON.stringify(contextData)}></script>
<script>
  const params = new URLSearchParams(window.location.search)

  function getInitialDimension(): string {
    const d = params.get('dimension')
    return d === 'dss' || d === 'policy' ? d : 'dss'
  }

  let selectedCountry = params.get('country') ?? ''
  let selectedDimension = getInitialDimension()
  let selectedSubdimensions = new Set<string>()
  const contextIndicators = {
    poblacion: { prefix: '', suffix: '', decimals: 0 },
    'pib-per-capita': { prefix: 'US$ ', suffix: '', decimals: 0 },
    'esperanza-vida': { prefix: '', suffix: ' años', decimals: 1 },
    'mortalidad-bruta': { prefix: '', suffix: ' por 1.000', decimals: 1 },
  }
  const contextData = {}
  const embeddedContext = document.getElementById('country-context-data')
  const buildContextData = embeddedContext?.textContent
    ? JSON.parse(embeddedContext.textContent)
    : contextData

  function updateCountryContext() {
    if (!selectedCountry) return
    Object.entries(contextIndicators).forEach(([slug, format]) => {
      const valueEl = document.querySelector('[data-context-value="' + slug + '"]')
      const metaEl = document.querySelector('[data-context-meta="' + slug + '"]')
      const rows = Array.isArray(buildContextData[slug]) ? buildContextData[slug] : []
      const latest = rows
        .filter((row) => String(row.territorio ?? '').trim() === selectedCountry)
        .sort((a, b) => Number(b.anio) - Number(a.anio))[0]
      if (!latest) {
        if (valueEl) valueEl.textContent = 'Sin datos'
        if (metaEl) metaEl.textContent = ''
        return
      }
      const number = new Intl.NumberFormat('es-CL', {
        minimumFractionDigits: format.decimals,
        maximumFractionDigits: format.decimals,
      }).format(Number(latest.valor))
      if (valueEl) valueEl.textContent = format.prefix + number + format.suffix
      if (metaEl) metaEl.textContent = latest.anio + ' · Banco Mundial'
    })
  }
  function getSubdimsForDimension(_dim: string): string[] {
    return Array.from(
      document.querySelectorAll<HTMLButtonElement>('[data-subdim-tag]'),
    ).map((btn) => btn.getAttribute('data-subdim-tag')!)
  }

  function selectAllSubdims() {
    selectedSubdimensions = new Set(getSubdimsForDimension(selectedDimension))
  }

  function filterIndicators() {
    const items = document.querySelectorAll<HTMLLIElement>(
      '#indicators-list [data-dimension]',
    )
    let visible = 0

    items.forEach((item) => {
      const dim = item.getAttribute('data-dimension') ?? ''
      const subs = (item.getAttribute('data-subdimensions') ?? '')
        .split(',')
        .filter(Boolean)
      const dimMatch = dim === selectedDimension
      // Selected DSS areas are alternatives (OR), not cumulative requirements.
      // Fall back to legacy subdimensions so indicators without `area` are not
      // silently hidden while the catalogue is being migrated.
      const subMatch =
        selectedSubdimensions.size === 0 ||
        subs.some((s) => selectedSubdimensions.has(s))
      if (dimMatch && subMatch) {
        item.style.display = ''
        visible++
      } else {
        item.style.display = 'none'
      }
    })

    document
      .getElementById('empty-message')
      ?.classList.toggle('hidden', visible > 0)
  }

  function updateDimensionButtons() {
    document
      .querySelectorAll<HTMLButtonElement>('[data-dim-btn]')
      .forEach((btn) => {
        const dim = btn.getAttribute('data-dim-btn') ?? ''
        const active = dim === selectedDimension
        btn.setAttribute('aria-pressed', String(active))
        if (active) {
          btn.classList.add('bg-gray-800', 'text-white')
          btn.classList.remove('bg-white', 'text-gray-700', 'hover:bg-gray-50')
        } else {
          btn.classList.remove('bg-gray-800', 'text-white')
          btn.classList.add('bg-white', 'text-gray-700', 'hover:bg-gray-50')
        }
      })
  }

  function updateSubdimTags() {
    document
      .querySelectorAll<HTMLButtonElement>('[data-subdim-tag]')
      .forEach((btn) => {
        const dim = btn.getAttribute('data-subdim-dim') ?? ''
        const sub = btn.getAttribute('data-subdim-tag') ?? ''

        // The six DSS areas apply to both Indicators and Policies.
        btn.classList.remove('hidden')
        const active = selectedSubdimensions.has(sub)
        btn.setAttribute('aria-pressed', String(active))
        if (active) {
          btn.classList.add('bg-blue-700', 'text-white', 'border-blue-700')
          btn.classList.remove('bg-white', 'text-blue-700', 'border-blue-200')
        } else {
          btn.classList.remove('bg-blue-700', 'text-white', 'border-blue-700')
          btn.classList.add('bg-white', 'text-blue-700', 'border-blue-200')
        }
      })
  }

  function updateCountryView() {
    const selector = document.getElementById('country-selector')
    const content = document.getElementById('country-content')
    const label = document.getElementById('selected-country-label')
    const select = document.getElementById('country-select') as HTMLSelectElement | null
    const enterBtn = document.getElementById('country-enter-btn') as HTMLButtonElement | null

    if (select) select.value = selectedCountry
    if (enterBtn) enterBtn.disabled = !(select?.value)

    if (selectedCountry) {
      selector?.classList.add('hidden')
      content?.classList.remove('hidden')
      if (label) label.textContent = selectedCountry\n      void updateCountryContext()
    } else {
      selector?.classList.remove('hidden')
      content?.classList.add('hidden')
    }

    document.querySelectorAll<HTMLAnchorElement>('[data-indicator-href]').forEach((link) => {
      const baseHref = link.getAttribute('data-indicator-href') ?? link.href
      const query = new URLSearchParams({
        country: selectedCountry,
        dimension: selectedDimension,
      })
      link.href = `${baseHref}?${query.toString()}`
    })
  }

  function setDimension(dim: string) {
    selectedDimension = dim
    selectAllSubdims()
    updateDimensionButtons()
    updateSubdimTags()
    filterIndicators()
    const query = new URLSearchParams({ country: selectedCountry, dimension: dim })
    history.replaceState(null, '', `?${query.toString()}`)
    updateCountryView()
  }

  const countrySelect = document.getElementById('country-select') as HTMLSelectElement | null
  const countryEnterBtn = document.getElementById('country-enter-btn') as HTMLButtonElement | null

  countrySelect?.addEventListener('change', () => {
    if (countryEnterBtn) countryEnterBtn.disabled = !countrySelect.value
  })

  countryEnterBtn?.addEventListener('click', () => {
    selectedCountry = countrySelect?.value ?? ''
    if (!selectedCountry) return
    const query = new URLSearchParams({ country: selectedCountry, dimension: selectedDimension })
    history.replaceState(null, '', `?${query.toString()}`)
    updateCountryView()
  })

  document.getElementById('change-country-btn')?.addEventListener('click', () => {
    selectedCountry = ''
    history.replaceState(null, '', window.location.pathname)
    updateCountryView()
  })

  document
    .querySelectorAll<HTMLButtonElement>('[data-dim-btn]')
    .forEach((btn) => {
      btn.addEventListener('click', () => {
        const dim = btn.getAttribute('data-dim-btn')
        if (dim && dim in { dss: 1, policy: 1 }) setDimension(dim)
      })
    })

  document
    .querySelectorAll<HTMLButtonElement>('[data-subdim-tag]')
    .forEach((btn) => {
      btn.addEventListener('click', () => {
        const sub = btn.getAttribute('data-subdim-tag') ?? ''
        if (selectedSubdimensions.has(sub)) {
          selectedSubdimensions.delete(sub)
        } else {
          selectedSubdimensions.add(sub)
        }
        updateSubdimTags()
        filterIndicators()
      })
    })

  selectAllSubdims()
  updateDimensionButtons()
  updateSubdimTags()
  filterIndicators()
  updateCountryView()
</script>
