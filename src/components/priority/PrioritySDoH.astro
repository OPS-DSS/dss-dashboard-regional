---
import { app, indicators } from '@/config/general'
import type { StratifiedRow } from '@/lib/parquet'

interface Props {
  title: string
  text: string
  allStratifiedData?: Record<string, StratifiedRow[]>
}

const { title, text, allStratifiedData = {} } = Astro.props

const countries = [
  ...new Set(
    Object.values(allStratifiedData)
      .flat()
      .map((row) => String(row.territorio ?? '').trim())
      .filter((territory) => Boolean(territory) && territory !== app.local),
  ),
].sort((a, b) => a.localeCompare(b, 'es'))

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/'

const areas = [
  { slug: 'economia', title: 'Trabajo, ingresos, seguridad económica y desigualdad', color: '#a53331', icon: 'flowbite:scale-balanced-solid' },
  { slug: 'educacion', title: 'Educación', color: '#c7743e', icon: 'flowbite:book-open-outline' },
  { slug: 'ambiente', title: 'Ambiente físico', color: '#7eb267', icon: 'flowbite:home-outline' },
  { slug: 'comunidad', title: 'Contexto social y comunitario', color: '#385495', icon: 'flowbite:users-group-outline' },
  { slug: 'salud', title: 'Conductas relacionadas con la salud', color: '#6fabc2', icon: 'flowbite:heart-outline' },
  { slug: 'sistema', title: 'Sistema de atención de salud', color: '#7a00c2', icon: 'icons8:doctor' },
]
const selectableIndicators = indicators.filter((ind) => !ind.priority)
---

<div class="mx-auto max-w-7xl px-2 sm:px-6 lg:px-10">
  <div class="flex flex-col gap-2">
    <h1 class="text-3xl font-bold my-6">{title}</h1>
    <p class="text-gray-700">{text}</p>

    <div id="country-selector" class="mt-4 rounded-lg border border-gray-200 p-5">
      <label for="country-select" class="block text-sm font-medium text-gray-700 mb-2">Seleccione un país de la Región de las Américas</label>
      <div class="flex flex-col sm:flex-row gap-3 sm:items-center">
        <select id="country-select" class="min-w-72 rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm text-gray-800">
          <option value="">Seleccione un país</option>
          {countries.map((country) => <option value={country}>{country}</option>)}
        </select>
        <button id="country-enter-btn" type="button" class="rounded-lg bg-gray-800 px-4 py-2 text-sm font-medium text-white disabled:opacity-40" disabled>Continuar</button>
      </div>
    </div>

    <div id="country-content" class="hidden">
      <div class="mt-4 flex items-center justify-between gap-3 flex-wrap">
        <p class="text-sm text-gray-600">País seleccionado: <strong id="selected-country-label"></strong></p>
        <button id="change-country-btn" type="button" class="text-sm font-medium text-blue-700 hover:underline">Cambiar país</button>
      </div>

      <section id="area-selector" class="mt-5">
        <h2 class="text-xl font-semibold mb-4">Seleccione una dimensión</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {areas.map((area) => (
            <button data-area-btn={area.slug} type="button" style={`background-color: ${area.color}`} class="w-full rounded-2xl border border-gray-300 px-6 py-5 text-left text-white shadow-sm transition hover:opacity-90 flex items-center justify-between gap-4">
              <span class="text-xl font-semibold">{area.title}</span>
              <span class="text-2xl" aria-hidden="true">›</span>
            </button>
          ))}
        </div>
      </section>

      <section id="indicator-selector" class="hidden mt-5">
        <button id="back-to-areas-btn" type="button" class="mb-4 text-sm font-medium text-blue-700 hover:underline">← Volver a dimensiones</button>
        <h2 id="selected-area-label" class="text-xl font-semibold mb-4"></h2>
        <div class="flex rounded-lg border border-gray-300 overflow-hidden text-sm w-fit mb-4">
          <button data-type-btn="dss" type="button" class="px-4 py-2 font-medium bg-gray-800 text-white">Indicadores</button>
          <button data-type-btn="policy" type="button" class="px-4 py-2 font-medium bg-white text-gray-700">Políticas</button>
        </div>
        <ul id="indicators-list" class="flex flex-col gap-4">
          {selectableIndicators.map((ind) => (
            <li data-type={ind.dimension} data-area={(ind as any).area ?? ''}>
              <a href={`${base}${ind.slug}`} data-indicator-href={`${base}${ind.slug}`} class="block rounded-lg border border-gray-200 p-4 hover:border-blue-400 hover:shadow-sm transition-all">
                <h3 class="text-lg font-semibold text-gray-900">{ind.title}</h3>
                <p class="mt-1 text-sm text-gray-600">{ind.description}</p>
              </a>
            </li>
          ))}
        </ul>
        <p id="empty-message" class="text-gray-500 italic mt-4 hidden">No hay indicadores disponibles para esta dimensión y tipo.</p>
      </section>
    </div>
  </div>
</div>
<script>
  const params = new URLSearchParams(window.location.search)
  let selectedCountry = params.get('country') ?? ''
  let selectedArea = params.get('area') ?? ''
  let selectedType = params.get('dimension') === 'policy' ? 'policy' : 'dss'

  const areaTitles: Record<string,string> = {
    economia: 'Trabajo, ingresos, seguridad económica y desigualdad',
    educacion: 'Educación',
    ambiente: 'Ambiente físico',
    comunidad: 'Contexto social y comunitario',
    salud: 'Conductas relacionadas con la salud',
    sistema: 'Sistema de atención de salud',
  }

  function syncUrl() {
    const q = new URLSearchParams()
    if (selectedCountry) q.set('country', selectedCountry)
    if (selectedArea) q.set('area', selectedArea)
    q.set('dimension', selectedType)
    history.replaceState(null, '', `?${q.toString()}`)
  }

  function updateLinks() {
    document.querySelectorAll<HTMLAnchorElement>('[data-indicator-href]').forEach((link) => {
      const href = link.getAttribute('data-indicator-href')!
      const q = new URLSearchParams({ country: selectedCountry, area: selectedArea, dimension: selectedType })
      link.href = `${href}?${q.toString()}`
    })
  }

  function filterIndicators() {
    let visible = 0
    document.querySelectorAll<HTMLLIElement>('#indicators-list [data-area]').forEach((item) => {
      const show = item.dataset.area === selectedArea && item.dataset.type === selectedType
      item.style.display = show ? '' : 'none'
      if (show) visible++
    })
    document.getElementById('empty-message')?.classList.toggle('hidden', visible > 0)
  }

  function updateTypeButtons() {
    document.querySelectorAll<HTMLButtonElement>('[data-type-btn]').forEach((btn) => {
      const active = btn.dataset.typeBtn === selectedType
      btn.classList.toggle('bg-gray-800', active)
      btn.classList.toggle('text-white', active)
      btn.classList.toggle('bg-white', !active)
      btn.classList.toggle('text-gray-700', !active)
    })
  }

  function updateView() {
    const selector = document.getElementById('country-selector')
    const content = document.getElementById('country-content')
    const areas = document.getElementById('area-selector')
    const indicatorsPanel = document.getElementById('indicator-selector')
    const label = document.getElementById('selected-country-label')
    const areaLabel = document.getElementById('selected-area-label')
    const select = document.getElementById('country-select') as HTMLSelectElement | null
    const enter = document.getElementById('country-enter-btn') as HTMLButtonElement | null
    if (select) select.value = selectedCountry
    if (enter) enter.disabled = !select?.value
    selector?.classList.toggle('hidden', Boolean(selectedCountry))
    content?.classList.toggle('hidden', !selectedCountry)
    if (label) label.textContent = selectedCountry
    areas?.classList.toggle('hidden', Boolean(selectedArea))
    indicatorsPanel?.classList.toggle('hidden', !selectedArea)
    if (areaLabel) areaLabel.textContent = areaTitles[selectedArea] ?? ''
    updateTypeButtons()
    filterIndicators()
    updateLinks()
  }

  const countrySelect = document.getElementById('country-select') as HTMLSelectElement | null
  const enter = document.getElementById('country-enter-btn') as HTMLButtonElement | null
  countrySelect?.addEventListener('change', () => { if (enter) enter.disabled = !countrySelect.value })
  enter?.addEventListener('click', () => {
    selectedCountry = countrySelect?.value ?? ''
    selectedArea = ''
    syncUrl(); updateView()
  })
  document.getElementById('change-country-btn')?.addEventListener('click', () => {
    selectedCountry = ''; selectedArea = ''; history.replaceState(null, '', window.location.pathname); updateView()
  })
  document.querySelectorAll<HTMLButtonElement>('[data-area-btn]').forEach((btn) => btn.addEventListener('click', () => {
    selectedArea = btn.dataset.areaBtn ?? ''; selectedType = 'dss'; syncUrl(); updateView()
  }))
  document.getElementById('back-to-areas-btn')?.addEventListener('click', () => {
    selectedArea = ''; syncUrl(); updateView()
  })
  document.querySelectorAll<HTMLButtonElement>('[data-type-btn]').forEach((btn) => btn.addEventListener('click', () => {
    selectedType = btn.dataset.typeBtn === 'policy' ? 'policy' : 'dss'; syncUrl(); updateView()
  }))
  updateView()
</script>

